{
  "id": "fixture.per-instrument-targets",
  "version": "1.0.0",
  "label": "Synthetic: each instrument has its own target, one of them a grade",
  "scope": {
    "type": "institution",
    "ref": null
  },
  "framework": {
    "code": "nba-ug-eng",
    "version": "gapc-v4.0",
