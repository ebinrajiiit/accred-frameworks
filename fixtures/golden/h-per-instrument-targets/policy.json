  },
  "assessment_groups": {
    "default_selection_rule": "all",
    "best_n_ties": "first"
  },
  "indirect": {
    "source": "course_exit_survey",
    "scale_min": 0,
    "scale_max": 5,
    "mapping": "linear",
    "min_responses": 5
  },
  "weights": {
    "direct": 0.8,
    "indirect": 0.2
  },
  "po": {
    "method": "weighted_average",
    "correlation_scale": {
      "min": 1,
      "max": 3
    },
    "ignore_correlation_below": 1
  },
  "program": {
    "course_weighting": "credits",
    "indirect_sources": [
      {
        "kind": "program_exit_survey",
        "weight": 0.5
      },
      {
        "kind": "alumni_survey",
        "weight": 0.3
      },
      {
        "kind": "employer_survey",
        "weight": 0.2
      }
    ],
    "weights": {
      "direct": 0.8,
      "indirect": 0.2
    },
    "default_target": 2,
    "targets_by_outcome": {},
    "require_action_plan_when_gap_above": 0
