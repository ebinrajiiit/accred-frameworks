    "order": [
      "S",
      "A+",
      "A",
      "B+",
      "B",
      "C+",
      "C",
      "D",
      "P",
      "F"
    ],
    "mapping": {
      "S": 95,
      "A+": 88,
      "A": 83,
      "B+": 78,
      "B": 73,
      "C+": 68,
      "C": 63,
      "D": 58,
      "P": 52,
      "F": 20
    }
  },
  "validation": {
