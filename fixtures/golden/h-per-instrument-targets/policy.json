    "min": 0,
    "max": 3
  },
  "direct": {
    "method": "target_ratio",
    "target_pct": 60,
    "bands": [
      {
        "at_least": 0.5,
        "level": 1
      },
      {
        "at_least": 0.6,
        "level": 2
      },
      {
        "at_least": 0.7,
        "level": 3
      }
    ],
    "combination": "component_levels",
