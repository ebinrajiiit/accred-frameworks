{
  "name": "accreditation-registry",
  "version": "2026.07.0",
  "private": true,
  "description": "Vendor-neutral accreditation framework registry, JSON schemas, and a pure attainment engine.",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "validate": "vitest run",
    "staleness": "node scripts/staleness.mjs",
    "fixtures": "node scripts/build-fixtures.mjs",
    "gate:imports": "depcruise packages/engine/src --config .dependency-cruiser.cjs",
    "gate:purity": "node scripts/purity-gate.mjs",
    "gate:privacy": "node scripts/privacy-gate.mjs",
    "gate:badge": "node scripts/badge.mjs --check",
    "badge": "node scripts/badge.mjs",
    "typecheck": "tsc -p packages/engine/tsconfig.json --noEmit",
    "gates": "npm run gate:imports && npm run gate:purity && npm run gate:privacy && npm run gate:badge",
    "ci": "npm run typecheck && npm run gates && npm test"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dependency-cruiser": "^17.4.3",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ebinrajiiit/accred-frameworks.git"
  },
  "homepage": "https://github.com/ebinrajiiit/accred-frameworks#readme",
  "bugs": {
    "url": "https://github.com/ebinrajiiit/accred-frameworks/issues"
  }
}
