{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://facts-h.iiitkottayam.ac.in/schemas/engine-input.schema.json",
  "title": "Attainment engine input document",
  "description": "Everything the engine needs to compute attainment for one course offering. This is a published API contract, versioned independently of the engine's internals: any tool can produce this document and any tool can consume the result, which is the point of publishing it.\n\nNo identifying student data belongs here beyond a roll number, and even that is only used for ordering and traceability.",
  "type": "object",
  "required": [
    "offering",
    "framework",
    "course_outcomes",
    "outcomes",
    "articulation",
    "assessments",
    "questions",
    "question_outcomes",
    "enrollments",
    "marks"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "offering": {
      "type": "object",
      "required": [
        "id",
        "course"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "term_id": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "course": {
          "type": "object",
          "required": [
            "id",
            "code",
            "title",
            "credits",
            "type"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "code": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "credits": {
              "type": "number",
              "minimum": 0
            },
            "type": {
              "enum": [
                "theory",
                "lab",
                "integrated",
                "project",
                "internship",
                "seminar",
                "mooc"
              ]
            }
          }
        },
        "see_mode": {
          "$ref": "#/$defs/seeMode"
        }
      }
    },
    "framework": {
      "type": "object",
      "description": "The framework the supplied outcome set belongs to. The engine refuses to run when this disagrees with the policy's framework binding — a twelve-outcome computation presented under an eleven-outcome framework is invalid, not merely imprecise.",
      "required": [
        "code",
        "version"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "outcome_count": {
          "type": "integer",
          "minimum": 1
        },
        "supersedes": {
          "type": "string"
        }
      }
    },
    "course_outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "code"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "bloom_level": {
            "$ref": "#/$defs/bloom"
          },
          "sequence": {
            "type": "integer"
          }
        }
      }
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "code",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "po",
              "pso",
              "so"
            ]
          },
          "statement": {
            "type": "string"
          },
          "sequence": {
            "type": "integer"
          }
        }
      }
    },
    "articulation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "course_outcome_id",
          "outcome_id",
          "correlation"
        ],
        "properties": {
          "course_outcome_id": {
            "type": "string"
          },
          "outcome_id": {
            "type": "string"
          },
          "correlation": {
            "type": "number",
            "minimum": 0
          },
          "justification": {
            "type": "string"
          },
          "migrated_from_outcome_code": {
            "type": "string"
          },
          "migration_rationale": {
            "type": "string"
          }
        }
      }
    },
    "wk_indicators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "code"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          }
        }
      }
    },
    "co_wk_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "course_outcome_id",
          "wk_indicator_id"
        ],
        "properties": {
          "course_outcome_id": {
            "type": "string"
          },
          "wk_indicator_id": {
            "type": "string"
          }
        }
      }
    },
    "assessment_groups": {
      "type": "array",
      "description": "A weighted bundle of assessments, e.g. 'best two of three quizzes'.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "weight_pct"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "selection_rule": {
            "enum": [
              "all",
              "best_n"
            ]
          },
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "weight_pct": {
            "type": "number",
            "minimum": 0
          },
          "outcome_weights": {
            "type": "array",
            "description": "What this instrument is worth for one course outcome, overriding weight_pct for that CO only. Institutions weight instruments differently per outcome — a CO taught through coursework might be 30% test / 30% assignment / 40% end-semester while a CO assessed only by examination is 50/0/50 in the same course. Collapsing that to one per-assessment weight silently reweights every outcome to the course average. Weights are normalised per CO, so they need not sum to 100.",
            "items": {
              "type": "object",
              "required": [
                "course_outcome_id",
                "weight_pct"
              ],
              "additionalProperties": false,
              "properties": {
                "course_outcome_id": {
                  "type": "string"
                },
                "weight_pct": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "max_marks",
          "weight_pct"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "cie",
              "see",
              "lab",
              "project",
              "survey_linked"
            ]
          },
          "max_marks": {
            "type": "number",
            "minimum": 0
          },
          "weight_pct": {
            "type": "number",
            "minimum": 0
          },
          "group_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "data_source": {
            "enum": [
              "question_wise",
              "totals",
              "grades",
              "co_wise"
            ],
            "description": "co_wise — marks recorded per course outcome rather than per question. Weaker provenance than question_wise: a figure resolves to a CO column on a mark sheet, not to a question a student answered, and every report says so."
          },
          "outcome_weights": {
            "type": "array",
            "description": "What this instrument is worth for one course outcome, overriding weight_pct for that CO only. Institutions weight instruments differently per outcome — a CO taught through coursework might be 30% test / 30% assignment / 40% end-semester while a CO assessed only by examination is 50/0/50 in the same course. Collapsing that to one per-assessment weight silently reweights every outcome to the course average. Weights are normalised per CO, so they need not sum to 100.",
            "items": {
              "type": "object",
              "required": [
                "course_outcome_id",
                "weight_pct"
              ],
              "additionalProperties": false,
              "properties": {
                "course_outcome_id": {
                  "type": "string"
                },
                "weight_pct": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "choice_groups": {
      "type": "array",
      "description": "'Answer any five of seven'. Required for the engine to reconstruct the paper an absent student would have faced.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "assessment_id",
          "required"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "assessment_id": {
            "type": "string"
          },
          "required": {
            "type": "integer",
            "minimum": 1
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "assessment_id",
          "label",
          "max_marks"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "assessment_id": {
            "type": "string"
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Set for a sub-question; a container carries no marks of its own."
          },
          "label": {
            "type": "string"
          },
          "max_marks": {
            "type": "number",
            "minimum": 0
          },
          "bloom_level": {
            "$ref": "#/$defs/bloom"
          },
          "choice_group": {
            "type": [
              "string",
              "null"
            ]
          },
          "is_optional": {
            "type": "boolean"
          },
          "sequence": {
            "type": "integer"
          }
        }
      }
    },
    "question_outcomes": {
      "type": "array",
      "description": "Question to course-outcome weights. Weights for one question sum to 1 — a question serving two outcomes might split 0.6 / 0.4.",
      "items": {
        "type": "object",
        "required": [
          "question_id",
          "course_outcome_id",
          "weight"
        ],
        "properties": {
          "question_id": {
            "type": "string"
          },
          "course_outcome_id": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "enrollments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "roll_no",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "student_id": {
            "type": "string"
          },
          "roll_no": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "dropped",
              "audit",
              "backlog",
              "transfer"
            ]
          }
        }
      }
    },
    "marks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "enrollment_id",
          "question_id",
          "score",
          "attempted"
        ],
        "properties": {
          "enrollment_id": {
            "type": "string"
          },
          "question_id": {
            "type": "string"
          },
          "score": {
            "type": "number",
            "minimum": 0
          },
          "attempted": {
            "type": "boolean",
            "description": "False for an unanswered choice alternative. NOT the same as a score of zero: an unattempted question is excluded from that student's denominator, which is what gives each student their own per-outcome maximum."
          },
          "status": {
            "$ref": "#/$defs/markStatus"
          }
        }
      }
    },
    "assessment_totals": {
      "type": "array",
      "description": "Used when only a total exists — an affiliated college receiving a mark, or only a grade, from its university.",
      "items": {
        "type": "object",
        "required": [
          "enrollment_id",
          "assessment_id"
        ],
        "properties": {
          "enrollment_id": {
            "type": "string"
          },
          "assessment_id": {
            "type": "string"
          },
          "total_score": {
            "type": "number",
            "minimum": 0
          },
          "grade": {
            "type": "string"
          },
          "status": {
            "$ref": "#/$defs/markStatus"
          }
        }
      }
    },
    "see_blueprint": {
      "type": "object",
      "description": "A published paper blueprint, for apportioning an end-semester total across outcomes.",
      "required": [
        "assessment_id",
        "distribution"
      ],
      "properties": {
        "assessment_id": {
          "type": "string"
        },
        "distribution": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "course_outcome_id",
              "marks"
            ],
            "properties": {
              "course_outcome_id": {
                "type": "string"
              },
              "marks": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "survey": {
      "type": "object",
      "description": "Course exit survey, for indirect attainment.",
      "required": [
        "responses"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "scale_min": {
          "type": "number"
        },
        "scale_max": {
          "type": "number"
        },
        "invited": {
          "type": "integer",
          "minimum": 0
        },
        "responses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "course_outcome_id",
              "rating"
            ],
            "properties": {
              "course_outcome_id": {
                "type": "string"
              },
              "rating": {
                "type": "number"
              },
              "respondent_token": {
                "type": "string",
                "description": "Opaque. Enables a response rate without identifying the respondent."
              }
            }
          }
        }
      }
    },
    "overrides": {
      "type": "array",
      "description": "Manual replacements of computed values. Never silent: each carries an author and a reason, and is marked visibly wherever the value appears.",
      "items": {
        "type": "object",
        "required": [
          "entity_type",
          "entity_id",
          "override_value",
          "reason",
          "author_id",
          "created_at"
        ],
        "properties": {
          "entity_type": {
            "enum": [
              "co_attainment",
              "po_attainment"
            ]
          },
          "entity_id": {
            "type": "string"
          },
          "override_value": {
            "type": "number"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "author_id": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "$defs": {
    "seeMode": {
      "enum": [
        "question_wise",
        "blueprint_uniform",
        "uniform_split",
        "threshold_proxy",
        "excluded"
      ],
      "description": "How end-semester data is available. Everything but question_wise is a fallback and carries a report stamp."
    },
    "markStatus": {
      "enum": [
        "present",
        "absent",
        "malpractice",
        "exempt",
        "not_attempted"
      ]
    },
    "bloom": {
      "enum": [
        "remember",
        "understand",
        "apply",
        "analyse",
        "evaluate",
        "create"
      ]
    }
  }
}
